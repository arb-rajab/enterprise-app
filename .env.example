# Copy this file to .env and adjust values for local docker-compose runs.
# .env is gitignored - never commit real secrets.

DB_NAME=procureflow
DB_USERNAME=procureflow
DB_PASSWORD=procureflow

# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# Optional: override the dev-only Keycloak client secret baked into keycloak/procureflow-realm.json
# and backend/src/main/resources/application.yml. There is no real IdP involved - see
# keycloak/README.md - so leaving this unset (falls back to "procureflow-dev-secret") is fine.
# OIDC_CLIENT_SECRET=procureflow-dev-secret
